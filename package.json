{
  "name": "margem-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Site editorial da MARGEM — política, economia e pessoas.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check && astro build",
    "preview": "astro preview",
    "check": "biome check . && astro check",
    "astro": "astro",
    "deployment:check": "node scripts/check-deployment.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test": "pnpm test:backend && pnpm test:coverage && pnpm test:e2e",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "pipeline": "node backend/scripts/run.mjs",
    "test:backend": "sh backend/scripts/check.sh",
    "bench:backend": "go -C backend test ./internal/api -run '^$' -bench 'Benchmark(RateLimiter|PublicationAPI|CachedPublicationAPI)$' -benchmem -benchtime=300ms -count=3",
    "generate:backend": "go -C backend generate ./internal/platform/postgres"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "5.0.4",
    "typescript": "^6.0.3",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@11.22.0"
}
