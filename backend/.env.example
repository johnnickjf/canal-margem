# Somente desenvolvimento local com backend/compose.yaml.
# Produção: Cloudflare R2; veja docs/systems/pipelines.md para endpoint e credenciais.
DATABASE_URL=postgresql://margem:local-only@127.0.0.1:55437/margem
S3_ENDPOINT_URL=http://127.0.0.1:59007
RAW_BUCKET=margem-raw
PUBLIC_BUCKET=margem-public
API_ADDR=127.0.0.1:8080
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_DEFAULT_REGION=us-east-1
# Cache de projeções verificadas: até 2 edições / 16 MiB serializados / TTL 60s.
# Não guarda perfis pessoais nem o alias atual. false desativa para diagnóstico.
API_SNAPSHOT_CACHE=true
