---
import BaseLayout from './BaseLayout.astro';
import PublicationNote from '@/components/platform/PublicationNote.astro';
import type { SeoProps } from '@/components/layout/Seo.astro';
import { site } from '@/config/site';
type Props = SeoProps & { title: string; description: string; compactTitle?: boolean };
const { title, description, compactTitle = false, ...seo } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: site.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: title,
      item: new URL(Astro.url.pathname, site.url).href,
    },
  ],
};
---
<BaseLayout title={title} description={description} jsonLd={jsonLd} {...seo}>
  <div class="container platform-page">
    <nav aria-label="Caminho"><a href="/">Início</a> / <span aria-current="page">{title}</span></nav>
    <header class:list={{ 'compact-title': compactTitle }}><p class="label">Margem / Vida em números</p><h1>{title}</h1><p class="platform-intro">{description}</p></header>
    <slot />
    <PublicationNote />
  </div>
</BaseLayout>
<style>
  .compact-title h1 { font-size: clamp(2.25rem, 4vw, 4rem); max-width: 32ch; }
</style>
