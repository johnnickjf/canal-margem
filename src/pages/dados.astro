---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Photo from '@/components/ui/Photo.astro';
import PublicationNote from '@/components/platform/PublicationNote.astro';
import { platform } from '@/lib/platform';
import { site } from '@/config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Dados', item: `${site.url}/dados/` },
  ],
};

const questions: Record<string, string> = {
  'trabalho-e-renda': 'O trabalho permite viver melhor?',
  'custo-de-vida': 'Quanto custa viver no Brasil?',
  'vida-financeira': 'Quanto da renda sobra?',
  'qualidade-de-vida': 'Como vivemos?',
  'economia-e-estado': 'Como a economia afeta a vida material?',
};
---

<BaseLayout title="Dados" description="Explore indicadores sobre trabalho, custo de vida, renda e economia, com fontes, contexto e limites para entender o Brasil." jsonLd={jsonLd}>
  <div class="data-page container">
    <header class="data-hero">
      <div class="data-hero__copy">
        <p class="label">Margem / Vida em números</p>
        <h1>A vida por trás <span>dos números.</span></h1>
        <p>Salário, comida, moradia, dívidas. Os dados ajudam a enxergar o que muda na vida de quem vive no Brasil.</p>
        <a href="#perguntas" class="data-hero__link">Escolha uma pergunta <span aria-hidden="true">↓</span></a>
      </div>
      <Photo photo="multidao-rua" ratio="4/5" sizes="(max-width: 760px) 100vw, 45vw" widths={[480, 800, 1200]} eager credit />
    </header>

    <section id="perguntas" class="data-section" aria-labelledby="perguntas-title">
      <div class="section-heading">
        <div><p class="label">01 / Explore por tema</p><h2 id="perguntas-title">O que você quer entender?</h2></div>
        <p>Comece por uma pergunta. Cada tema reúne indicadores, explicações e caminhos para aprofundar a leitura.</p>
      </div>
      <ul class="theme-list">
        {platform.themes.map((theme, index) => {
          const count = platform.indicators.filter((indicator) => indicator.theme === theme.slug && indicator.role === 'primary').length;
          return <li><a href={`/tema/${theme.slug}`} class="theme-card">
            <span class="theme-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="theme-card__body"><span class="label">{theme.name}</span><strong>{questions[theme.slug] ?? theme.question}</strong><span class="theme-card__meta">{count} {count === 1 ? 'indicador' : 'indicadores'}</span></span>
            <span class="theme-card__arrow" aria-hidden="true">↗</span>
          </a></li>;
        })}
      </ul>
    </section>

    <section class="data-section data-explore" aria-labelledby="explorar-title">
      <div><p class="label">02 / Vá mais fundo</p><h2 id="explorar-title">Um número não conta tudo.</h2><p>Fontes, períodos e métodos fazem parte da história. Explore os dados e saiba como interpretá-los.</p></div>
      <ul class="explore-links">
        <li><a href="/comparar"><strong>Compare períodos</strong><span>Veja o que mudou ao longo do tempo.</span><span aria-hidden="true">↗</span></a></li>
        <li><a href="/entenda"><strong>Entenda os conceitos</strong><span>Conheça as ideias por trás dos indicadores.</span><span aria-hidden="true">↗</span></a></li>
        <li><a href="/auditoria"><strong>Confira as fontes</strong><span>Acompanhe a origem e a publicação dos dados.</span><span aria-hidden="true">↗</span></a></li>
      </ul>
    </section>
    <PublicationNote />
  </div>
</BaseLayout>

<style>
  .data-page { padding-block: var(--space-xl); display: grid; gap: clamp(4rem, 8vw, 8rem); }
  .data-hero { display: grid; grid-template-columns: 1fr minmax(0, 0.85fr); gap: clamp(2rem, 6vw, 7rem); align-items: center; }
  .data-hero__copy { display: grid; gap: var(--space-md); align-content: center; }
  h1, h2 { font-family: var(--font-display); text-transform: uppercase; line-height: .95; }
  h1 { font-size: clamp(4rem, 8vw, 8rem); max-width: 10ch; }
  h1 span { color: var(--red); }
  .data-hero__copy > p:not(.label) { max-width: 35ch; font-size: var(--text-lg); }
  .data-hero__link { font-family: var(--font-mono); font-size: var(--text-sm); text-transform: uppercase; text-decoration-thickness: 2px; text-underline-offset: .35em; }
  .data-hero__link span { margin-left: .5rem; color: var(--red); }
  .data-section { display: grid; gap: var(--space-lg); }
  .section-heading { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-lg); align-items: end; border-top: var(--rule-strong); padding-top: var(--space-md); }
  h2 { font-size: clamp(2.8rem, 5vw, 5rem); max-width: 15ch; margin-top: var(--space-sm); }
  .section-heading > p, .data-explore > div > p:last-child { max-width: 42ch; }
  .theme-list, .explore-links { list-style: none; padding: 0; margin: 0; }
  .theme-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: var(--rule); border-left: var(--rule); }
  .theme-list li { min-width: 0; }
  .theme-card { height: 100%; min-height: 15rem; display: flex; gap: var(--space-md); padding: var(--space-md); border-right: var(--rule); border-bottom: var(--rule); color: var(--fg); text-decoration: none; background: var(--surface); }
  .theme-card__number { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--red); }
  .theme-card__body { display: flex; flex: 1; flex-direction: column; gap: var(--space-md); }
  .theme-card__body strong { font-family: var(--font-display); font-size: clamp(1.8rem, 3vw, 2.8rem); font-weight: 400; line-height: 1; }
  .theme-card__meta { margin-top: auto; font-family: var(--font-mono); font-size: var(--text-sm); }
  .theme-card__arrow { color: var(--red); font-size: 1.5rem; }
  .theme-card:hover strong, .theme-card:focus-visible strong { color: var(--red); }
  .data-explore { grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); border-top: var(--rule-strong); padding-top: var(--space-md); }
  .data-explore > div { display: grid; align-content: start; gap: var(--space-md); }
  .explore-links { border-top: var(--rule); }
  .explore-links a { display: grid; grid-template-columns: 1fr auto; gap: .3rem 1rem; padding-block: var(--space-md); border-bottom: var(--rule); text-decoration: none; color: var(--fg); }
  .explore-links strong { font-family: var(--font-display); font-size: 2rem; font-weight: 400; }
  .explore-links span:nth-child(2) { grid-column: 1; }
  .explore-links span:last-child { grid-column: 2; grid-row: 1; color: var(--red); font-size: 1.5rem; }
  .explore-links a:hover strong, .explore-links a:focus-visible strong { color: var(--red); }
  @media (max-width: 900px) { .theme-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .data-hero, .section-heading, .data-explore { grid-template-columns: 1fr; } .data-hero > :global(.photo) { max-height: 28rem; } }
  @media (max-width: 520px) { .theme-list { grid-template-columns: 1fr; } .theme-card { min-height: 12rem; } }
</style>
