---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedVideos from '@/components/sections/FeaturedVideos.astro';
import LatestCuts from '@/components/sections/LatestCuts.astro';
import ThemesIndex from '@/components/sections/ThemesIndex.astro';
import ManifestoTeaser from '@/components/sections/ManifestoTeaser.astro';
import LatestAnalyses from '@/components/sections/LatestAnalyses.astro';
import Newsletter from '@/components/sections/Newsletter.astro';
import AboutContact from '@/components/sections/AboutContact.astro';
import PlatformEntry from '@/components/platform/PlatformEntry.astro';
import { site, socials } from '@/config/site';

const title = 'O que você quer entender?';
const description =
  'Explore perguntas sobre trabalho, renda, custo de vida, dívidas e condições de vida no Brasil. Encontre indicadores, fontes e explicações, além de vídeos e análises.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  slogan: site.tagline,
  description: site.positioning,
  sameAs: socials.map((s) => s.href),
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <PlatformEntry />
  <FeaturedVideos />
  <LatestCuts />
  <ThemesIndex />
  <ManifestoTeaser />
  <LatestAnalyses />
  <Newsletter />
  <AboutContact />
</BaseLayout>
