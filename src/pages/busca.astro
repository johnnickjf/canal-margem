---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { getTemas, routes } from '@/lib/content';
import { platform } from '@/lib/platform';
import { platformSearchItems } from '@/lib/platform-search';

const temas = await getTemas();
const catalog = platformSearchItems(platform);
const explanations = catalog.filter((item) => item.type === 'Entenda');
---

<BaseLayout title="Busca" description="Encontre indicadores, conceitos econômicos, vídeos e análises com palavras do dia a dia: comida, salário, aluguel e dívida.">
  <section class="search container" aria-labelledby="busca-titulo">
    <p class="label search__label"><span class="search__mark" aria-hidden="true"></span>Busca</p>
    <h1 id="busca-titulo">O que você quer entender?</h1>
    <p class="search__intro" id="search-hint">Busque com suas palavras. Encontre indicadores, explicações e conteúdo editorial.</p>

    <form id="search-form" class="search__form" role="search" action="/busca" method="get" data-search-form>
      <label for="q" class="visually-hidden">O que você procura?</label>
      <input
        id="q"
        name="q"
        type="search"
        class="search__input"
        placeholder="Aluguel, jornada, imposto…"
        aria-describedby="search-hint"
        maxlength="200"
        autocomplete="off"
        spellcheck="false"
        data-search-input
      />
      <button type="submit" class="search__submit">
        <Icon name="search" size={28} />
        <span class="visually-hidden">Buscar</span>
      </button>
    </form>

    <div class="search__tools">
      <label for="search-type">Buscar em</label>
      <select id="search-type" name="tipo" form="search-form" data-search-type>
        <option value="">Tudo</option>
        <option value="indicadores">Indicadores</option>
        <option value="entenda">Entenda</option>
        <option value="acervo">Vídeos e análises</option>
        <option value="temas">Temas</option>
        <option value="politicas">Políticas públicas</option>
        <option value="estudos">Estudos e evidências</option>
      </select>
    </div>
    <ul class="search__temas search__examples" role="list" aria-label="Experimente buscar">
      {['comida', 'gasolina', 'salário', 'aluguel', 'dívida'].map((word) => <li><a href={`/busca?q=${encodeURIComponent(word)}`} data-search-example={word}>{word}</a></li>)}
    </ul>
    <noscript><p class="search__intro">A pesquisa por palavras usa JavaScript. Você pode explorar todos os indicadores e conceitos pelos links abaixo.</p></noscript>

    <p class="search__status label" role="status" aria-live="polite" data-search-status></p>

    <button type="button" class="search__retry" data-search-retry hidden>Tentar novamente</button>

    <ol class="search__results" role="list" data-search-results></ol>

    <div class="search__suggest" data-search-suggest>
      <h2>Explore os indicadores</h2>
      <p>Os resultados levam às definições e aos recortes de cada indicador. A disponibilidade dos dados é informada na página de destino.</p>
      <div class="search__catalog">
        {platform.themes.map((theme) => <details>
          <summary>{theme.name}</summary>
          <ul role="list">{platform.indicators.filter((indicator) => indicator.theme === theme.slug).map((indicator) => <li>
            <a href={`/indicador/${indicator.slug}`}>{indicator.name}</a>
            <p>{indicator.question}</p>
          </li>)}</ul>
          <a href={`/tema/${theme.slug}`}>Explorar o tema: {theme.name}</a>
        </details>)}
        <details><summary>Entenda a economia</summary>
          <ul role="list">{explanations.map((item) => <li><a href={item.url}>{item.title}</a></li>)}</ul>
        </details>
        <details><summary>Políticas públicas e história</summary>
          <ul role="list">{catalog.filter((item) => item.type === 'Política').map((item) => <li><a href={item.url}>{item.title}</a></li>)}</ul>
          <a href="/politicas">Explorar legislação, vigências e governos</a>
        </details>
        <details><summary>Estudos e evidências</summary>
          <ul role="list">{catalog.filter((item) => item.type === 'Estudo').map((item) => <li><a href={item.url}>{item.title}</a></li>)}</ul>
          <a href="/evidencias">Entender os critérios e limites da evidência</a>
        </details>
      </div>
      <h2>Temas editoriais</h2>
      <ul role="list" class="search__temas">
        {temas.map((tema) => <li><a href={routes.tema(tema.id)}>{tema.data.name}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  import { mountSearch } from '@/scripts/search-page';
  mountSearch();
</script>

<style>
  .search {
    min-height: 70vh;
    padding-block: var(--space-xl) var(--section-y);
  }

  h1 {
    margin-top: var(--space-lg);
    font-family: var(--font-display);
    font-size: var(--display-md);
    line-height: 1.1;
  }

  .search__intro { margin-top: var(--space-sm); max-width: var(--measure); }
  .search__tools { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm); margin-block: var(--space-md); }
  .search__tools select { max-width: 100%; min-height: 44px; padding: var(--space-xs); border: var(--rule); background: var(--paper); }
  .search__retry { min-height: 44px; text-decoration: underline; }
  .search__catalog { display: grid; gap: var(--space-sm); margin-block: var(--space-md) var(--space-lg); }
  .search__catalog details { border: var(--rule); padding: var(--space-sm) var(--space-md); }
  .search__catalog summary { cursor: pointer; min-height: 44px; align-content: center; font-weight: 600; }
  .search__catalog li { margin-block: var(--space-sm); }
  .search__catalog a { display: inline-block; padding-block: var(--space-xs); }
  .search__catalog p { font-size: var(--text-sm); }
  .search__suggest h2 { font-family: var(--font-display); font-size: var(--display-sm); margin-bottom: var(--space-sm); }
  .search__results :global(.result__description) { max-width: var(--measure); }

  .search__label {
    display: flex;
    align-items: center;
    gap: 0.9em;
    padding-bottom: var(--space-sm);
    border-bottom: var(--rule);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
  }

  .search__mark {
    width: 14px;
    height: 7px;
    background: var(--red);
  }

  .search__form {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    border-bottom: 2px solid var(--charcoal);
  }

  .search__input {
    flex: 1;
    min-width: 0;
    padding: 0.1em 0 0;
    border: 0;
    background: transparent;
    font-family: var(--font-display);
    font-size: var(--display-xl);
    line-height: 1;
    text-transform: uppercase;
    color: var(--charcoal);
  }

  .search__input::placeholder {
    color: var(--fg-muted);
  }

  .search__input:focus-visible {
    outline: none;
  }

  .search__form:focus-within {
    border-bottom-color: var(--red);
  }

  .search__input::-webkit-search-cancel-button {
    display: none;
  }

  .search__submit {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
  }

  .search__submit:hover {
    color: var(--red);
  }

  .search__status {
    margin-top: var(--space-md);
    color: var(--fg-muted);
    min-height: 1.4em;
  }

  .search__results {
    margin-top: var(--space-lg);
  }

  .search__results :global(.result) {
    border-bottom: var(--rule);
  }

  .search__results :global(.result a) {
    display: grid;
    gap: 4px;
    padding-block: var(--space-md);
    text-decoration: none;
  }

  .search__results :global(.result__type) {
    font-family: var(--font-mono);
    font-size: var(--label-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--red);
  }

  .search__results :global(.result__title) {
    font-family: var(--font-display);
    font-size: var(--display-sm);
    line-height: 1;
    text-transform: uppercase;
  }

  .search__results :global(.result a:hover .result__title) {
    color: var(--red);
  }

  .search__results :global(.result__meta) {
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .search__suggest {
    margin-top: var(--space-xl);
  }

  .search__suggest-label {
    color: var(--fg-muted);
    margin-bottom: var(--space-sm);
  }

  .search__temas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .search__temas a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 0.9rem;
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .search__temas a:hover {
    background: var(--charcoal);
    border-color: var(--charcoal);
    color: var(--paper);
  }
</style>
