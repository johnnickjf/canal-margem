---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { contact, site, socials } from '@/config/site';
import { voice } from '@/data/manifesto';
---

<section class="section about" aria-labelledby="sobre-titulo">
  <div class="container about__grid">
    <div class="about__col">
      <SectionHeader index={7} label="Sobre a MARGEM" />
      <h2 id="sobre-titulo" class="about__title" data-reveal>
        Análise crítica do <span class="hl">Brasil real</span>
      </h2>
      <p class="about__text" data-reveal>{site.positioning}</p>
      <p class="about__text about__text--muted" data-reveal>
        Partimos das condições materiais da vida cotidiana — trabalho, renda, aluguel, comida, transporte,
        tempo — para chegar à política. Com dados conferidos, contexto histórico e contrapontos honestos.
      </p>

      <ul class="about__voice" role="list" aria-label="Como falamos">
        {voice.map((word) => <li>{word}</li>)}
      </ul>

      <Button href="/sobre" variant="outline" icon="arrow-right">Conheça o projeto</Button>
    </div>

    <div class="about__col">
      <SectionHeader index={8} label="Contato" />
      <div class="about__contact">
        <a class="about__mail" href={`mailto:${contact.email}`}>
          <span class="label about__mail-label">Fale com a redação</span>
          <span class="about__mail-address">{contact.email}</span>
        </a>
        <a class="about__mail" href={`mailto:${contact.pautas}`}>
          <span class="label about__mail-label">Sugira uma pauta</span>
          <span class="about__mail-address">{contact.pautas}</span>
        </a>
      </div>

      <h3 class="label about__channels-title">Onde estamos</h3>
      <ul class="about__channels" role="list">
        {
          socials.map((social) => (
            <li>
              <a href={social.href} rel="me noopener" target="_blank">
                <span class="about__channel-name">{social.label}</span>
                <Icon name="arrow-up-right" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-2xl) var(--column-gap);
  }

  .about__col {
    display: grid;
    align-content: start;
  }

  .about__title {
    font-size: var(--display-lg);
    max-width: 10ch;
  }

  .about__text {
    margin-top: var(--space-md);
    font-size: var(--text-lg);
    max-width: 46ch;
  }

  .about__text--muted {
    font-size: var(--text-base);
    color: var(--fg-muted);
  }

  .about__voice {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin-block: var(--space-lg);
    padding-block: var(--space-md);
    border-block: var(--rule);
  }

  .about__voice li {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .about__voice li::after {
    content: '';
    display: block;
    width: 22px;
    height: 3px;
    margin-top: 6px;
    background: var(--red);
  }

  .about__contact {
    display: grid;
    gap: var(--space-md);
  }

  .about__mail {
    display: grid;
    gap: var(--space-xs);
    padding-bottom: var(--space-md);
    border-bottom: var(--rule);
    text-decoration: none;
  }

  .about__mail-label {
    color: var(--fg-muted);
  }

  .about__mail-address {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
    line-height: 1;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    transition: color var(--dur) var(--ease);
  }

  .about__mail:hover .about__mail-address {
    color: var(--red);
  }

  .about__channels-title {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    color: var(--fg-muted);
  }

  .about__channels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: var(--rule-strong);
  }

  .about__channels li {
    border-bottom: var(--rule);
  }

  .about__channels li:nth-child(odd) {
    border-right: var(--rule);
  }

  .about__channels a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: 56px;
    padding-inline: var(--space-sm);
    text-decoration: none;
    font-weight: 500;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .about__channels a:hover {
    background: var(--charcoal);
    color: var(--paper);
  }

  @media (min-width: 1080px) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: calc(var(--column-gap) * 3);
    }
  }
</style>
