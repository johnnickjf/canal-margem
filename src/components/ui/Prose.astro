---
/**
 * Tipografia de leitura para conteúdo em Markdown.
 * Corpo em Inter 18px, medida de ~66 caracteres, citações como olho em Bebas.
 */
interface Props {
  dropcap?: boolean;
  class?: string;
}

const { dropcap = false, class: className } = Astro.props;
---

<div class:list={['prose', { 'prose--dropcap': dropcap }, className]}>
  <slot />
</div>

<style>
  .prose {
    max-width: var(--measure);
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--fg);
  }

  .prose :global(> * + *) {
    margin-top: 1.25em;
  }

  .prose :global(h2) {
    margin-top: 2.2em;
    font-size: var(--display-sm);
    line-height: 1;
  }

  .prose :global(h2 + *) {
    margin-top: 0.75em;
  }

  .prose :global(h3) {
    margin-top: 1.8em;
    font-size: var(--display-xs);
  }

  .prose :global(a) {
    text-decoration-color: var(--red);
    text-decoration-thickness: 1.5px;
  }

  .prose :global(a:hover) {
    color: var(--red);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.2em;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(ul li::marker) {
    color: var(--red);
  }

  .prose :global(ol li::marker) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--red);
  }

  /* Olho / citação de destaque */
  .prose :global(blockquote) {
    margin-block: 2em;
    padding: 1.2em 0 1em 1.2em;
    border-left: 4px solid var(--red);
    border-top: var(--rule);
    border-bottom: var(--rule);
  }

  .prose :global(blockquote p) {
    font-family: var(--font-display);
    font-size: var(--display-sm);
    line-height: 1;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .prose :global(hr) {
    margin-block: 2.5em;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--paper-deep);
    padding: 0.1em 0.35em;
  }

  .prose--dropcap :global(> p:first-of-type::first-letter) {
    float: left;
    margin: 0.06em 0.12em 0 0;
    font-family: var(--font-display);
    font-size: 4.6em;
    line-height: 0.8;
    color: var(--red);
  }
</style>
