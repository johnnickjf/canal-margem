---
import Photo from '@/components/ui/Photo.astro';
import type { PhotoKey } from '@/data/photos';
interface Props {
  label: string;
  title: string;
  description: string;
  photo: PhotoKey;
  target: string;
  action: string;
}
const { label, title, description, photo, target, action } = Astro.props;
---
<section class="editorial-intro" aria-label={label}>
  <div class="editorial-intro__copy">
    <p class="label">{label}</p><p class="editorial-intro__title">{title}</p><p>{description}</p>
    <a href={target}>{action} <span aria-hidden="true">↓</span></a>
  </div>
  <Photo photo={photo} ratio="3/2" sizes="(max-width: 760px) 100vw, 45vw" widths={[480, 800, 1200]} credit />
</section>
<style>
  .editorial-intro { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; border-block: var(--rule); padding-block: var(--space-lg); }
  .editorial-intro__copy { display: grid; gap: var(--space-md); }
  .editorial-intro__title { font-family: var(--font-display); font-size: clamp(2.3rem, 4vw, 4rem); text-transform: uppercase; line-height: 1; max-width: 16ch; }
  .editorial-intro__copy > a { justify-self: start; font-family: var(--font-mono); font-size: var(--text-sm); text-underline-offset: .3em; }
  .editorial-intro__copy > a span { color: var(--red); }
  @media (max-width: 760px) { .editorial-intro { grid-template-columns: 1fr; } }
</style>
