---
import { platform } from '@/lib/platform';
const path = Astro.url.pathname.replace(/\/$/, '');
const links = [
  ...platform.themes.map((theme) => ({ href: `/tema/${theme.slug}`, name: theme.name })),
  { href: '/comparar', name: 'Comparar' },
  { href: '/politicas', name: 'Políticas e história' },
  { href: '/evidencias', name: 'Estudos e evidências' },
  { href: '/entenda', name: 'Entenda os dados' },
];
---
<nav class="platform-nav container" aria-label="Dados e indicadores">
  <span class="label">Vida em números</span>
  <ul role="list">
    {links.map((link) => <li><a href={link.href} aria-current={path === link.href ? 'page' : path.startsWith(`${link.href}/`) ? 'true' : undefined}>{link.name}</a></li>)}
  </ul>
</nav>
<style>
  .platform-nav { padding-block: var(--space-sm); border-bottom: var(--rule); }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); margin-top: var(--space-xs); }
  a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--text-sm); text-underline-offset: 5px; }
  a[aria-current='page'], a[aria-current='true'] { color: var(--red); font-weight: 600; }
</style>
